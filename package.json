{
  "name": "personal-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "pnpm": ">=11.5.2 <12.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "dev:tunnel": "tsx watch --env-file-if-exists=.env.tunnel src/server.ts",
    "dev:web": "vite --config web/consent/vite.config.ts",
    "dev:token": "bash scripts/dev-token.sh",
    "smoke": "tsx scripts/mcp-smoke.ts",
    "build": "pnpm build:web && pnpm build:server",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/consent/vite.config.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "RUN_DB_TESTS=1 vitest run tests/platform --config vitest.config.ts",
    "migrations:check": "supabase db reset --local",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "^9.1.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@supabase/supabase-js": "2.107.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "jose": "6.2.3",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "22.19.20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "supabase": "2.105.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}

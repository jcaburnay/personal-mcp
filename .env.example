# Example environment for personal-mcp.
# Values below are the LOCAL defaults (Supabase CLI stack from `pnpm exec supabase status`).
# For a deployed instance, see docs/SELF_HOSTING.md — replace each Supabase value with your project's.

NODE_ENV=development                 # production when deployed
PORT=3000                            # your host's port (Render uses 10000)
LOG_LEVEL=info

# Public HTTPS URL of THIS server (used as the OAuth resource). Local: http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Postgres. Local: the CLI stack. Prod: Supabase "Transaction pooler" string (port 6543) + ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Your Supabase project. Local: the CLI stack on :55321. Prod: https://<ref>.supabase.co (+ /auth/v1 ...)
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_AUTH_ISSUER=http://127.0.0.1:55321/auth/v1
SUPABASE_JWKS_URL=http://127.0.0.1:55321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase publishable key (consent UI client). Local: from `pnpm exec supabase status`.
# Prod: Supabase Settings -> API Keys -> Publishable key (sb_publishable_...).
SUPABASE_PUBLISHABLE_KEY=replace-with-local-supabase-publishable-key-from-supabase-status

MCP_SERVER_NAME=personal-mcp
MCP_SERVER_VERSION=0.1.0

# Comma-separated allowed CORS origins. Add your MCP client(s), e.g. https://chatgpt.com
ALLOWED_ORIGINS=http://localhost:3000
